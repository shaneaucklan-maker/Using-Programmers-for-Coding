#solution
def solution(citations):
    answer=[]
    for i in range(max(citations)+1):
        cnt1=0
        cnt2=0
        cnt3=0
        for j in range(len(citations)):
            if citations[j]>i:
                cnt1+=1
            if citations[j]==i:
                cnt2+=1
            if citations[j]<i:
                cnt3+=1
        sa=cnt1+cnt2
        sb=cnt3
        if sa>=i and sb<=i:
            answer.append(i)
            
    return max(answer)
    
