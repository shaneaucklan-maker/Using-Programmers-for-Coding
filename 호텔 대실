from collections import deque
import heapq
def solution(book_time):
    
    for i in book_time:
        i[0]=int(i[0][0:2])*60+int(i[0][3:5])
        i[1]=int(i[1][0:2])*60+int(i[1][3:5])
    book_time.sort()
    
    cnt=1
    end=book_time[0][1]
    stack=[]
    heapq.heappush(stack,end)
    
    for i in range(len(book_time)-1):
        end=heapq.heappop(stack)
        
        if book_time[i+1][0]<end+10:
            heapq.heappush(stack,end)
            heapq.heappush(stack,book_time[i+1][1])
        else:
            heapq.heappush(stack,book_time[i+1][1])
    
    return len(stack)
                                        
            
        
                
                
