import heapq
def solution(N, stages):
    
    stages.sort()
    n=len(stages)
    answer=[]
    for i in range(1,N+1):
        f=stages.count(i)
        if n!=0:
            a=float(f/n)
        else:
            a=0
        n-=f
        answer.append([-a,i])
    heapq.heapify(answer)
    
    answer2=[]
    while answer:
        answer2.append(heapq.heappop(answer)[1])
    return answer2
        
