#solution
def solution(n, arr1, arr2):
    an=[]
    for i in range(len(arr1)):
        a=bin(arr1[i])[2::]
        b=bin(arr2[i])[2::] 
        a=(n-len(a))*"0"+a
        b=(n-len(b))*"0"+b
        q=""
        for j in range(len(a)):
            if a[j]=="1" or b[j]=="1":
                q+="#"
            elif a[j]=="0" and b[j]=="0":
                q+=" "
        an.append(q)
    return an
