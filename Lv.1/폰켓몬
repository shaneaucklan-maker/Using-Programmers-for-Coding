from collections import Counter
def solution(nums):
    n=len(nums)//2
    b=Counter(nums)
    answer={-1}
    while n>0: 
        for i in b:
            if b.get(i):
                b[i]-=1
                answer.add(int(i))
                n-=1
                if n==0:
                    break
    return len(answer)-1
