from math import sqrt

from itertools import permutations

def find(i):
    global flag
    flag=True
    for _ in range(2,int(sqrt(i))+1):
        if i%_==0:
            flag=False
            return flag
            break
    return flag
                
def solution(numbers):
    p=[]
    for i in numbers:
        p.append((i))
    q=[]    
    
    for j in range(1,len(numbers)+1):
        q.append(list(permutations(p,j)))
        
    
    cnt =0
    a=[]
    for i in q:
        for j in i:
            if find(int("".join(j))):
                a.append(int("".join(j)))
                
                
    b=list(set(a))  
    for i in b:
        if i!=1 and i!=0:
            cnt+=1
    return cnt
