def solution(nums):
    n=len(nums)//2
    
    b={}
    for i in nums:
        if not b.get(str(i)):
            b[str(i)]=1
        else:
            b[str(i)]+=1
    
    a=[]
    cnt=0
    c={}
    while n>0:
        for i in b:
            if b[i]>0:
                b[i]-=1
                if not c.get(i):
                    c[i]=1
                else:
                    c[i]+=1
                n-=1
                if n==0:
                    break
    return len(c)
