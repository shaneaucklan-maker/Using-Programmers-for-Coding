from collections import deque
def solution(s):
    
    cnt=0
    q=1
    idx=0
    check=[]
    flag=False
    s=deque(s)
    if len(s)==1:
        return 1
    st=s.popleft()
    
    while s:
        qu=s.popleft()
        if st==qu:
            q+=1
            if not s:
                cnt+=1
        else:
            q-=1
            if q==0:
                q=1
                cnt+=1
                check.append((st,qu))
                if not s:
                    break
                else:
                    st=s.popleft()
                    if not s:
                        cnt+=1
                        check.append((st,qu))
            else:
                if not s:
                    cnt+=1
                        
    
    return cnt
        
        
    
        
                
        
