#solution
def solution(arr1, arr2):
    n=len(arr1)
    m=len(arr1[0])
    q=len(arr2[0])
    answer=[]
    for i in range(n):
        u=[]
        for k in range(q):
        
            b=0
            for j in range(m):
                b+=arr1[i][j]*arr2[j][k]
            u.append(b)
        answer.append(u)
    return answer
