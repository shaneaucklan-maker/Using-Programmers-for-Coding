#solution
def solution(fees, records):
    
    jb=[]
    b={}
    for i in records:
        if i[-2]=="I":
            if not b.get(int(i[6:10])):
                b[int((i[6:10]))]=-int(i[0:2])*60-int(i[3:5])
            else:
                b[int((i[6:10]))]-=int(i[0:2])*60+int(i[3:5])
        else:
            b[(int(i[6:10]))]=int(i[0:2])*60+int(i[3:5])+b[(int(i[6:10]))]
    
    for i in b:
        if b[i]<=0:
            b[i]+=24*60-1
            
            if b[i]//fees[0]>=1:
                if (b[i]-fees[0])%fees[2]>0:
                    b[i]=fees[1]+fees[3]*((b[i]-fees[0])//fees[2]+1)
                else:
                    b[i]=fees[1]+fees[3]*((b[i]-fees[0])//fees[2])
            else:
                b[i]=fees[1]
        else: 
            if b[i]//fees[0]>=1:
                if (b[i]-fees[0])%fees[2]>0:
                    b[i]=fees[1]+fees[3]*((b[i]-fees[0])//fees[2]+1)
                else:
                    b[i]=fees[1]+fees[3]*((b[i]-fees[0])//fees[2])
            else:
                b[i]=fees[1]
    for i in sorted(b.items()):
        jb.append(i[1])
    return jb
        
