from collections import deque
def solution(queue1, queue2):
    queue1=deque(queue1)
    queue2=deque(queue2)
    a=sum(queue1)
    b=sum(queue2)
    c=len(queue1)
    d=len(queue2)
    cnt=0
    target=a+b
    if target%2==1: 
        return -1
    if a==b:
        return 0
    
    
    while a!=b:
        
        
        if a>b and c!=1:
            minus=queue1.popleft()
            queue2.append(minus)
            b+=minus
            a-=minus
            c-=1
            d+=1
            cnt+=1
            
        elif a<b and d!=1:
            minus=queue2.popleft()
            queue1.append(minus)
            a+=minus
            b-=minus
            d-=1
            c+=1
            cnt+=1
        
        elif a<b and d==1:
            return -1
        elif a>b and c==1:
            return -1
    
        if cnt==(len(queue1)+len(queue2))*3:
            return -1
        
    return cnt
