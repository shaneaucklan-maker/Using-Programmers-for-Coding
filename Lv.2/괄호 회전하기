from collections import deque
def solution(s):
    
    s=deque(s)
    def w():
        a=[]
        for i in range(len(s)):
            if not a:
                a.append(s[i])
            else:
                if a[-1]=="[" and s[i]=="]":
                    a.pop()
                elif a[-1]=="(" and s[i]==")":
                    a.pop()
                elif a[-1]=="{" and s[i]=="}":
                    a.pop()
                else:
                    a.append(s[i])
        if not a:
            return True
    cnt=0
    for i in range(len(s)):
        if w():
            cnt+=1
        
        s.append(s.popleft())
    
    return cnt
            
        
            
