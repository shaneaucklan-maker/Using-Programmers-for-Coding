#solution
from collections import Counter
def solution(weights):
    w=Counter(weights)
    cnt=0
    
    for i in w:
        if w[i]>1:
            cnt+=w[i]*(w[i]-1)//2
        
        if int(i)*3%2==0 and int(i)*3/2 in w:
            cnt+=w[i]*w[int(i)*3/2]
        if int(i)*2 in w:
            cnt+=w[i]*w[int(i)*2]
        if int(i)*4%3==0 and int(i)*4/3 in w: 
            cnt+=w[i]*w[int(i)*4/3]
    return cnt
