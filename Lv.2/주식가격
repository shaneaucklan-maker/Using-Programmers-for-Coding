#solution
def solution(prices):
    answer=[]
    for i in range(len(prices)):
        cnt=0
        for j in range(i+1,len(prices)):
            if j!=len(prices)-1:
                if prices[i]<=prices[j]:
                    cnt+=1
                else:
                    cnt+=1
                    answer.append(cnt)
                    break
            else:
                cnt+=1
                answer.append(cnt)
    answer.append(0)           
    return answer
