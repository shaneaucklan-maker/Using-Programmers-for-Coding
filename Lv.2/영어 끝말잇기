#solution
def solution(n, words):
    b={}
    for i in range(len(words)):
        if not b.get(words[i]):
            b[words[i]]=1
        else:
            return[(i%n+1),i//n+1]
        try:
            if words[i][-1]!=words[i+1][0]:
                return [((i+1)%n+1),(i+1)//n+1]
        except:
            IndexError
    return [0,0]
