from collections import deque
def solution(s):
    a=[]
    
    for i in s:
        if a:
            if a[-1]=="(":
                if i==")":
                    a.pop()
                else:
                    a.append(i)
            else:
                a.append(i)
        else:
            a.append(i)
    
    if not a:
        return True
    else:
        return False
    
    
