#solution
def solution(n, results):
    graph=[[int(1e9) for i in range(n+1)]for i in range(n+1)]
    
    for i in range(n+1):
        for j in range(n+1):
            if i==j:
                graph[i][j]=0
    for a,b in results:
        graph[a][b]=1
        graph[b][a]=-1
    #return graph
    for k in range(1,n+1):
        for i in range(1,n+1):
            for j in range(1,n+1):
                if graph[i][j]==1 and graph[j][k]==1:
                    graph[i][k]=1
                if graph[i][j]==-1 and graph[j][k]==-1:
                    graph[i][k]=-1
    for k in range(1,n+1):
        for i in range(1,n+1):
            for j in range(1,n+1):
                if graph[i][j]==1 and graph[j][k]==1:
                    graph[i][k]=1
                if graph[i][j]==-1 and graph[j][k]==-1:
                    graph[i][k]=-1
    cnt=0
    for i in range(1,n+1):
        q=0
        for j in range(1,n+1):
            if graph[i][j]!=int(1e9):
                q+=1
        if q==n:
            cnt+=1
    #return graph
    return cnt
