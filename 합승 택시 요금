#solution
def solution(n, s, a, b, fares):
    graph=[[int(1e9) for i in range(n+1)] for j in range(n+1)]
    for i in range(n+1):
        graph[i][i]=0
    for z,x,v in fares:
        graph[z][x]=v
        graph[x][z]=v
    for k in range(1,n+1):
        for i in range(1,n+1):
            for j in range(1,n+1):
                if graph[i][j]>graph[i][k]+graph[k][j]:
                    graph[i][j]=graph[i][k]+graph[k][j]
    #return graph
    check=[]
    answer=int(1e11)
    for i in range(1,n+1):
        answer=min(graph[s][i]+graph[i][a]+graph[i][b],answer)
        check.append(graph[s][i]+graph[i][a]+graph[i][b])
    #return check
    return answer
    
