#solution
def solution(m, n, puddles):
    route=[[1 for i in range(m)]for j in range(n)]
    
    for a,b in puddles:
        route[b-1][a-1]=0
    
    for i in range(n):
        for j in range(m):
            try:
                if route[0][j]==0:
                    route[0][j+1]=0
                if route[i][0]==0:
                    route[i+1][0]=0
            except:
                IndexError
    
    for i in range(n):
        for j in range(m):
            try:
                if route[i+1][j+1]!=0:
                    route[i+1][j+1]=route[i+1][j]+route[i][j+1]
            except:
                IndexError
    return route[-1][-1]%1000000007
                
            
