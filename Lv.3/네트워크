#solution
def solution(n, computers):
    
    parent=[i for i in range(n)]
    
    def find(a):
        if a==parent[a]:
            return a
        else:
            parent[a]=find(parent[a])
            return parent[a]
    def union(a,b):
        a=find(a)
        b=find(b)
        
        if a<b:
            parent[b]=a
        else:
            parent[a]=b
    
    for i in range(n):
        for j in range(n):
            if i!=j and computers[i][j]==1:
                union(i,j)
                
    for i in range(n):
        for j in range(n):
            if i!=j and computers[i][j]==1:
                union(i,j)
    return len(set(parent))
