#solution
def solution(keymap, targets):
    b={}
    for i in keymap:
        for j in range(len(i)):
            if not b.get(i[j]):
                b[i[j]]=j+1
            else:
                if b[i[j]]>j+1:
                    b[i[j]]=j+1
    answer=[]
    for i in targets:
        cnt=0
        for j in i:
            if b.get(j):
                cnt+=b[j]
            else:
                cnt=-1
                break
        answer.append(cnt)
    return answer
