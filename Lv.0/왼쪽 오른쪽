def solution(str_list):
    answer = []
    for i in range(len(str_list)):
        if str_list[i]=="l" and i>0:
            return str_list[:i]
        elif str_list[i]=="l" and i==0:
            return []
        elif str_list[i]=="r":
            return str_list[i+1::]
    return answer
