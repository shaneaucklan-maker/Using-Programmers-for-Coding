from collections import deque
def solution(board):
    n=len(board)
    m=len(board[0])
    
    for i in range(n):
        for j in range(m):
            if board[i][j]==1:
                try:
                    if 0<=j+1 and j+1<m and board[i][j+1]!=1:
                        board[i][j+1]=-1
                    if 0<=i+1 and i+1<n and board[i+1][j]!=1:
                        board[i+1][j]=-1
                    if 0<=i-1 and i-1<n and board[i-1][j]!=1:
                        board[i-1][j]=-1
                    if 0<=j-1 and j-1<m and board[i][j-1]!=1:
                        board[i][j-1]=-1
                    if 0<=i+1 and i+1<n and 0<=j-1 and j-1<m and board[i+1][j-1]!=1:
                        board[i+1][j-1]=-1
                    if 0<=i-1 and i-1<n and 0<=j+1 and j+1<m and board[i-1][j+1]!=1:
                        board[i-1][j+1]=-1
                    if 0<=j-1 and j-1<m and 0<=i-1 and i-1<n and board[i-1][j-1]!=1:
                        board[i-1][j-1]=-1
                    if 0<=i+1 and i+1<n and 0<=j+1 and j+1<m and board[i+1][j+1]!=1:
                        board[i+1][j+1]=-1
                except:
                    IndexError
    cnt=0
    for i in range(n):
        for j in range(m):
            if board[i][j]==1 or board[i][j]==-1:
                cnt+=1
    return n*m-cnt
