#solution
def solution(want, number, discount):
    c={}
    for i in want:
        c[i]=1
    b=c.copy()
    
    q=0
    cnt=0
    
    
    while True:
        flag=True
        b=c.copy()
        
        if len(discount[q:q+10])<10:
            break
        else:
            for i in discount[q:q+10]:
                if b.get(i):
                    b[i]+=1
                else:
                    pass
            for i in range(len(want)):
                if b[want[i]]!=number[i]+1:
                    flag=False
                    
                    q+=1
                    break
            if flag:
                q+=1
                cnt+=1
                
                
    return cnt
                
        
        
        
        
        
        
        
        
