from itertools import combinations
from math import sqrt
def solution(nums):
    def find(a):
        flag=True
        for i in range(2,int(sqrt(a))+1):
            if a%i==0:
                flag=False
                break
        return flag
        
    cnt=0        
    for i in list(combinations(nums,3)):
        a=sum(i)
        if find(a):
            cnt+=1
    return cnt
