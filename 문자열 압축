#solution
def solution(s):
    n=len(s)
    q=n//2
    stack=[]
    answer=int(1e9)    
    
    for i in range(1,q+1):
        qwer=""
        for j in range(0,len(s),i):
            try:
                if not qwer:
                    qwer+=s[j:j+i]
                    n=1
                if s[j:j+i]==s[j+i:j+i+i]:
                    n+=1
                else:
                    if n!=1:
                        qwer+=str(n)
                    
                    qwer+=s[j+i:j+i+i]
                    n=1
                    
            except:
                IndexError
        answer=min(answer,len(qwer))
    
    if len(s)==1:
        return 1
    return answer
                    
            
                
