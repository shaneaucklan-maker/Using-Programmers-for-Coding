import heapq
def solution(money):
    dp1=money.copy()
    
    dp2=money.copy()
    
    
    #첫째항 제외
    for i in range(1,len(money)):
        if i==0 or i==1:
            dp1[i]=money[i]
        elif i==2:
            dp1[i]=max(money[1:3])
        else:
            dp1[i]=max(dp1[i-2]+money[i],dp1[i-1])

    #return dp1
    
    for i in range(0,len(money)-1):
        if i==0:
            dp2[i]=money[i]
        elif i==1:
            dp2[i]=max(money[0:2])
        else:
            dp2[i]=max(dp2[i-2]+money[i],dp2[i-1])

    dp2=dp2[0:-1]
    
    #return dp2
    
    return max(max(dp2),max(dp1))
