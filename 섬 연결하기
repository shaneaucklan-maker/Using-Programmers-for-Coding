#solution
def solution(n, costs):
    parent=[i for i in range(n)]
    costs.sort(key=lambda x:x[2])
      
    
    def find(a):
        if a==parent[a]:
            return a
        else:
            parent[a]=find(parent[a])
            return parent[a]
        
    def union(a,b):
        a=find(a)
        b=find(b)
        if a<b:
            parent[b]=a
        elif a>b:
            parent[a]=b
    cnt=0
    answer=0
    while cnt<n-1:
        for v,b,r in costs:
            if find(v)!=find(b):
                union(v,b)
                answer+=r
                cnt+=1
    return answer
    
